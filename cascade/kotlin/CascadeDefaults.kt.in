package com.v2ray.ang.handler

import java.io.File
import java.io.FileOutputStream
import java.io.InputStream

/** Distribution defaults and their repair policy; user profiles remain owned by upstream. */
internal object CascadeDefaults {
    const val DNS_MIGRATION_KEY = "cascade_dns_defaults_version"
    const val DNS_MIGRATION_VERSION = 2

    internal val previousRouting = @LEGACY_ROUTING@

    val settings: Map<String, Any> = linkedMapOf(
@SETTINGS@
    )

    val assetSources: Map<String, String> = linkedMapOf(
@ASSETS@
    )

    /** Only the complete factory DNS tuple from releases .1/.2 is eligible for replacement. */
    private val legacyDnsSettings: List<Map<String, Any>> = listOf(
        mapOf("pref_local_dns_enabled" to false,
            "pref_remote_dns" to "https://cloudflare-dns.com/dns-query",
            "pref_domestic_dns" to "223.5.5.5"),
        mapOf("pref_local_dns_enabled" to true,
            "pref_remote_dns" to "https://1.1.1.1/dns-query",
            "pref_domestic_dns" to "https://1.1.1.1/dns-query")
    )

    /** Seed and migrate in one locked transaction; restore old values if any write fails. */
    fun applySettings(
        existing: Map<String, Any>,
        write: (String, Any) -> Boolean,
        remove: (String) -> Unit
    ) {
        val changes = settings.filterKeys { it !in existing }.toMutableMap()
        if ((existing[DNS_MIGRATION_KEY] as? Int ?: 0) < DNS_MIGRATION_VERSION) {
            if (legacyDnsSettings.any { tuple -> tuple.all { (key, value) -> existing[key] == value } } &&
                existing["pref_routing_ruleset"] == previousRouting &&
                existing["pref_vpn_dns"] == "1.1.1.1" &&
                (existing["pref_fake_dns_enabled"] == null || existing["pref_fake_dns_enabled"] == false)
            ) {
                (legacyDnsSettings.first().keys + "pref_fake_dns_enabled" + "pref_routing_ruleset").forEach { key ->
                    changes[key] = settings.getValue(key)
                }
            }
            changes[DNS_MIGRATION_KEY] = DNS_MIGRATION_VERSION
        }
        val written = mutableListOf<String>()
        try {
            changes.forEach { (key, value) ->
                written.add(key)
                check(write(key, value)) { "Failed to persist distribution settings" }
            }
        } catch (error: Exception) {
            written.asReversed().forEach { key ->
                try {
                    if (key in existing) {
                        check(write(key, existing.getValue(key))) { "Failed to restore distribution settings" }
                    } else {
                        remove(key)
                    }
                } catch (rollbackError: Exception) {
                    error.addSuppressed(rollbackError)
                }
            }
            throw error
        }
    }

    /** Call while holding the owning MMKV store lock. Existing keys include false/empty values. */
    fun <T> addMissing(
        existing: Set<String>,
        defaults: Map<String, T>,
        write: (String, T) -> Boolean,
        remove: (String) -> Unit
    ) {
        val added = mutableListOf<String>()
        try {
            defaults.forEach { (key, value) ->
                if (key !in existing) {
                    added.add(key)
                    check(write(key, value)) { "Failed to persist a distribution default" }
                }
            }
        } catch (error: Exception) {
            added.asReversed().forEach(remove)
            throw error
        }
    }

    fun missingAssets(existingNames: Collection<String>): Map<String, String> =
        assetSources.filterKeys { it !in existingNames }

    /** Copy to the same directory, then rename; a failed read must not leave a partial DAT. */
    @Synchronized
    fun copyMissingAsset(target: File, open: () -> InputStream): Boolean {
        if (target.exists()) return false
        check(target.parentFile?.isDirectory == true) { "Asset directory does not exist" }
        val temporary = File.createTempFile(".cascade-", ".tmp", target.parentFile)
        try {
            open().use { input ->
                FileOutputStream(temporary).use { output ->
                    input.copyTo(output)
                    output.fd.sync()
                }
            }
            if (target.exists()) return false
            check(temporary.renameTo(target)) { "Failed to install a distribution asset" }
            return true
        } finally {
            temporary.delete()
        }
    }

    /** Share the restore monitor so a manual update can commit only a complete downloaded file. */
    @Synchronized
    fun replaceAssetFile(temporary: File, target: File): Boolean {
        if (temporary.renameTo(target)) return true
        temporary.delete()
        return false
    }
}
